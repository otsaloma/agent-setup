#!/bin/bash
set -e
allow_list=()
deny_list=()

# System-specific files and directories
IFS=: read -r -a allow_paths <<< "${CODING_AGENT_SANDBOX_ALLOW:-}"
for path in "${allow_paths[@]}"; do
    test -n "$path" && allow_list+=(--bind "$path" "$path")
done

# Docker (potential root access!)
if test -z "${CODING_AGENT_SANDBOX_ALLOW_DOCKER:-}"; then
    deny_list+=(--ro-bind /dev/null /run/docker.sock)
fi

# .env files under $PWD and anywhere else (as per last locate db update)
while IFS= read -r -d '' env; do
    test -f "$env" && deny_list+=(--ro-bind /dev/null "$env")
done < <(find "$PWD" -name .env -type f -print0 2>/dev/null
         locate -0 -b -r '^\.env$')

# Allow D-Bus access for notify-send, www-open and gh token in keyring
bus="$XDG_RUNTIME_DIR/coding-agent-sandbox-$$.bus"
exec 3< <(exec xdg-dbus-proxy \
          --fd=1 "$DBUS_SESSION_BUS_ADDRESS" "$bus" --filter \
          --talk=org.freedesktop.Notifications \
          --talk=org.freedesktop.portal.Desktop \
          --talk=org.freedesktop.secrets)
read -r -n1 -u3

# Allow Wayland display for GUI tests
wayland=()
if test -n "$WAYLAND_DISPLAY"; then
    wayland+=(--ro-bind "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"
              --setenv GTK_A11Y none
              --unsetenv DISPLAY)
fi

exec bwrap \
     --ro-bind / / \
     --dev-bind /dev /dev \
     --proc /proc \
     --tmpfs /tmp \
     --bind "$PWD" "$PWD" \
     --bind $HOME/.aws/cli/cache $HOME/.aws/cli/cache \
     --bind $HOME/.aws/sso/cache $HOME/.aws/sso/cache \
     --bind $HOME/.cache $HOME/.cache \
     --bind $HOME/.claude $HOME/.claude \
     --bind $HOME/.claude.json $HOME/.claude.json \
     --bind $HOME/.codex $HOME/.codex \
     --bind $HOME/.gemini $HOME/.gemini \
     --bind $HOME/.local/bin $HOME/.local/bin \
     --bind $HOME/.local/share/claude $HOME/.local/share/claude \
     --bind $HOME/.local/state/claude $HOME/.local/state/claude \
     --bind $HOME/.npm $HOME/.npm \
     --bind $HOME/.npm-global $HOME/.npm-global \
     --bind $HOME/.pi $HOME/.pi \
     "${allow_list[@]}" \
     --tmpfs $XDG_RUNTIME_DIR \
     --bind "$bus" $XDG_RUNTIME_DIR/bus \
     --bind $XDG_RUNTIME_DIR/gcr $XDG_RUNTIME_DIR/gcr \
     "${wayland[@]}" \
     --perms 000 --tmpfs $HOME/.gnupg \
     --tmpfs /etc/ssh/ssh_config.d \
     --perms 700 --tmpfs $HOME/.ssh \
     --ro-bind $HOME/.ssh/known_hosts $HOME/.ssh/known_hosts \
     "${deny_list[@]}" \
     --setenv BROWSER www-open \
     --setenv GH_BROWSER www-open \
     --chdir "$PWD" \
     "$@"
